# === MySQL (optional — configure via setup wizard instead) ===
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=Mirrativ
MYSQL_USER=clip
MYSQL_PASSWORD=changeme

# === Web UI ===
PORT=3001
# Leave ADMIN_USER and ADMIN_PASS empty to trigger the first-time setup wizard.
# Once setup is complete, credentials are saved in config/server_config.json.
# You can also set them here to skip the wizard (e.g. for automated deployments).
ADMIN_USER=
ADMIN_PASS=

# === Recording targets ===
# Mirrativ user ID for the special clip-command integration (めんたこ専用)
CLIP_USER_ID=
# Comma-separated Mirrativ user IDs visible to guest users (leave empty to hide all from guests)
GUEST_USER_IDS=

# === Discord webhooks (set via setup wizard or here) ===
DISCORD_WEBHOOK_RECORDER=
DISCORD_WEBHOOK_CLIP=
# Public-facing URL used in share links sent to Discord
PUBLIC_URL=

# === キーワード警報 ===
# コメントに含まれると警報を送るキーワード（カンマ区切り、空欄で無効）
ALERT_KEYWORDS=ガチっす,がちっす
# 警報メッセージの冒頭テキスト
ALERT_MESSAGE=🚨🌪️益子警報🌪️🚨
