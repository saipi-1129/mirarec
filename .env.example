# === MySQL ===
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=Mirrativ
MYSQL_USER=clip
MYSQL_PASSWORD=changeme

# === Web UI ===
PORT=3001
ADMIN_USER=admin
ADMIN_PASS=changeme
# Public-facing URL (used in share links sent to Discord)
PUBLIC_URL=http://localhost:3001

# === Recording targets ===
# Mirrativ user ID to watch for clip commands (e.g. !切り抜き) in MySQL comments
# Also used to identify which user's comments come from direct MySQL integration
MENTAKO_USER_ID=YOUR_USER_ID_HERE
# Comma-separated Mirrativ user IDs visible to guest users (leave empty to hide all from guests)
GUEST_USER_IDS=YOUR_USER_ID_HERE

# === Discord webhooks ===
# Recorder events (stream start/end)
DISCORD_WEBHOOK_RECORDER=https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE
# Clip creation notifications
DISCORD_WEBHOOK_CLIP=https://discord.com/api/webhooks/YOUR_CLIP_WEBHOOK_HERE
